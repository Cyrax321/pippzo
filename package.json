{
  "name": "social-studio-agent",
  "description": "Open-source AI social media studio: an agent that writes, designs, schedules, and engages in your brand voice. Bring your own API keys.",
  "license": "MIT",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:studio": "open http://127.0.0.1:54323 2>/dev/null || xdg-open http://127.0.0.1:54323 2>/dev/null || echo 'Supabase Studio: http://127.0.0.1:54323'",
    "seed:brand": "node scripts/seed-brand.mjs",
    "secrets:encrypt": "node scripts/encrypt-secrets.mjs",
    "tunnel": "PORT=$(grep -E '^APP_PORT=' .env 2>/dev/null | head -1 | cut -d= -f2- | tr -d '\"'\"'\"' \\r'); ngrok http ${PORT:-5173}",
    "cron:once": "./scripts/cron-tick.sh",
    "cron:install": "./scripts/install-cron.sh",
    "cron:uninstall": "launchctl bootout gui/$(id -u)/dev.social-studio.cron 2>/dev/null; rm -f ~/Library/LaunchAgents/dev.social-studio.cron.plist; echo 'cron agent removed'"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3",
    "@ai-sdk/google": "^3",
    "@ai-sdk/openai": "3",
    "@ai-sdk/openai-compatible": "^2.0.48",
    "@ai-sdk/react": "^3.0.195",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.108.2",
    "@tailwindcss/vite": "^4.2.1",
